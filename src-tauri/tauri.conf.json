{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Morf",
  "version": "0.2.0",
  "identifier": "dev.morf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Morf",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#f6f5f1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: https://cdn.jsdelivr.net; font-src 'self' data:; media-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Convert, compress and count, all on your computer.",
    "longDescription": "Morf converts audio, video and images, compresses media and PDFs, and counts words, without uploading anything.",
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt"
    },
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQkUxRDc0RTVEQTk5OUEKUldTYW1kcmxkQjIrNGZtRnFzMWZ2RjUrTDM3cG50VXlkZ1V1UEVha2hISnA3UlNOb2ZqVTI3WnUK",
      "endpoints": [
        "https://github.com/giancoferrari/morf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
