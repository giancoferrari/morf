{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Morf",
  "version": "0.1.0",
  "identifier": "dev.morf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Morf",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#f6f5f1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Convert, compress and count, all on your computer.",
    "longDescription": "Morf converts audio, video and images, compresses media and PDFs, and counts words, without uploading anything.",
    "externalBin": ["binaries/ffmpeg"],
    "resources": { "binaries/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt" },
    "license": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
